VITE_NETLIFY_BUILD_HOOK_2=https://api.netlify.com/build_hooks/68a043657036b600d073cf02

# Google Cloud Storage Configuration
GCS_BUCKET_NAME=applicant-connect-images-yourname
GCS_PROJECT_ID=formuploadsproject
GCS_KEY_FILE=./gcs-key.json
GCS_BASE_URL=https://storage.googleapis.com

# Optional: Netlify Functions URL (for production)
# NETLIFY_FUNCTIONS_URL=https://your-site.netlify.app/.netlify/functions
# UI feature flags
# Show the local image download button only when true and environment is local/dev/standalone
VITE_ENABLE_LOCAL_DOWNLOAD=false
# Show the "Push to web" button only when true and environment is local/dev/standalone
VITE_ENABLE_PUSH=false
# Mark when running the packaged standalone app (set to true in standalone build/process)
VITE_STANDALONE=false

# --- Vetting/NIN feature flags ---
VITE_DEFAULT_ROLE=admin
# Choose 'MOCK' for offline testing, or your provider name (e.g., DOJAH, YOUVERIFY, SEAMFIX)
VITE_NIN_PROVIDER=MOCK
# If using a real provider, set the base url and API key:
# VITE_NIN_API_BASE=
# VITE_NIN_API_KEY=

# Optional webhook to capture audit logs and vetting updates on your backend / Apps Script
#VITE_WRITE_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwVi9S5vDqlrsvHIR0DeoBJ_dRGB6zI46c1j3QjObWwzD8s9OcGXqEnXM0QOQk2RfNO/exec

# Apps Script Web App endpoint to append vetted applicant rows
