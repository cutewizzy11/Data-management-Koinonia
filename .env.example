# Environment example - copy to .env for local development

# Google Sheets configuration
VITE_GOOGLE_SHEETS_ID=your_google_sheets_id_here
VITE_API_KEY=your_google_api_key_here

# Netlify build hook URL used by the Push to web button in production
# Example: https://api.netlify.com/build_hooks/xxxxxxxxxxxxxxxxxxxxxxxx
VITE_NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/your-hook-id
# Optional: second Netlify build hook if you want to trigger two sites/environments
VITE_NETLIFY_BUILD_HOOK_2=https://api.netlify.com/build_hooks/your-second-hook-id
# --- Vetting/NIN feature flags ---
VITE_DEFAULT_ROLE=admin
# Choose 'MOCK' for offline testing, or your provider name (e.g., DOJAH, YOUVERIFY, SEAMFIX)
VITE_NIN_PROVIDER=MOCK
# If using a real provider, set the base url and API key:
# VITE_NIN_API_BASE=
# VITE_NIN_API_KEY=

# Optional webhook to capture audit logs and vetting updates on your backend / Apps Script
VITE_WRITE_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwVi9S5vDqlrsvHIR0DeoBJ_dRGB6zI46c1j3QjObWwzD8s9OcGXqEnXM0QOQk2RfNO/exec